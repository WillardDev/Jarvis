# Environment variables

Copy to `.env`. Never commit secrets.

## Server
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

## Audio
STT_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=24000

## Providers (mock | deepgram | anthropic | cartesia | elevenlabs)
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

## Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

## Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
LLM_MAX_TOKENS=1024

## Cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=sonic-english

## ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

## Data (optional, behind docker compose profile `data`)
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@postgres:5432/jarvis
REDIS_URL=redis://redis:6379/0
